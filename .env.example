# CareerOneStop API credentials for the live national scholarship database.
# Register (free): https://www.careeronestop.org/Developers/WebAPI/registration.aspx
# These are SERVER-SIDE ONLY. No VITE_ prefix, so they are never exposed to the
# browser. Copy this file to .env and fill in real values. Never commit .env.
CAREERONESTOP_USERID=your-user-id
CAREERONESTOP_TOKEN=your-api-token
