# Copy this file to .env.local. Everything here is server-side only (no VITE_
# prefix), so no key is ever exposed to the browser. Without them the tool still
# works: resume upload falls back to local extraction and the scholarship
# matcher uses the curated set.

# Resume understanding + semantic ranking. Free key from Google AI Studio.
GEMINI_API_KEY=replace_with_your_key

# Live national scholarship database (CareerOneStop).
# Register (free): https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CAREERONESTOP_USERID=your-user-id
CAREERONESTOP_TOKEN=your-api-token
